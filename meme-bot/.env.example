# Copia in .env e modifica. Tutte le variabili hanno un default (vedi bot/config.py).

# paper = simulazione (CONSIGLIATO per iniziare), live = soldi veri
BOT_MODE=paper
BOT_CHAIN=solana
BOT_SCAN_INTERVAL_SEC=30

# Filtri
BOT_MIN_LIQUIDITY_USD=20000
BOT_MAX_FDV_USD=10000000
BOT_MIN_VOLUME_H1_USD=10000
BOT_MIN_TXNS_H1=100
BOT_MIN_BUY_SELL_RATIO_H1=1.1
BOT_MIN_AGE_MINUTES=15
BOT_MAX_AGE_MINUTES=1440
BOT_USE_RUGCHECK=true

# Rischio
BOT_TRADE_SIZE_SOL=0.05
BOT_MAX_OPEN_POSITIONS=3
BOT_MAX_DAILY_LOSS_SOL=0.3
BOT_PAPER_START_BALANCE_SOL=1.0

# Uscite
BOT_TAKE_PROFIT_PCT=60
BOT_STOP_LOSS_PCT=20
BOT_TRAILING_ACTIVATION_PCT=25
BOT_TRAILING_STOP_PCT=15
BOT_MAX_HOLD_MINUTES=180

# Solo LIVE - usa un wallet DEDICATO con pochi fondi. Non committare mai questo file.
BOT_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
BOT_WALLET_PRIVATE_KEY=
BOT_JUPITER_API_URL=https://lite-api.jup.ag/swap/v1
BOT_JUPITER_API_KEY=
BOT_SLIPPAGE_BPS=300
BOT_PRIORITY_FEE_LAMPORTS=200000
